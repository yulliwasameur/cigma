{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cigma.local/schemas/relation-observation.schema.json",
  "title": "CIGMA relation observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id", "source", "subject_observation_id", "predicate",
    "object_observation_id", "quality", "collected_at", "locator",
    "evidence_excerpt", "evidence_sha256"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["tls", "pki", "cbom", "cicd", "cmdb", "ot"]},
    "subject_observation_id": {"type": "string", "minLength": 1},
    "predicate": {"enum": ["HOSTS", "PRESENTS", "USES", "ISSUED-BY", "DEPENDS-ON", "DEPLOYS", "PROCESSES", "PROTECTS"]},
    "object_observation_id": {"type": "string", "minLength": 1},
    "quality": {"type": "number", "minimum": 0, "maximum": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "locator": {"type": "string", "minLength": 1},
    "evidence_excerpt": {"type": "string"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
